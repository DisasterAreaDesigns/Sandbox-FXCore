			macrd    acc32, ring+1326
			rddelx   r12, r15
			addi     r15, 4
			cpy_cc   r15, acc32
			sra      r12, 7                ; 1/128 keeps the sum in range
			macrd    acc32, ring+1330
			rddelx   r12, r15
			addi     r15, 4
			cpy_cc   r15, acc32
			sra      r12, 7                ; 1/128 keeps the sum in range
			macrd    acc32, ring+1334
			rddelx   r12, r15
			addi     r15, 4
