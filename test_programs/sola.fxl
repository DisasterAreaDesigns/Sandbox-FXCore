			sra      r12, 7                ; 1/128 keeps the sum in range
			macrd    acc32, ring+1610
			rddelx   r12, r15
			addi     r15, 4
			cpy_cc   r15, acc32
			sra      r12, 7                ; 1/128 keeps the sum in range
			macrd    acc32, ring+1614
			rddelx   r12, r15
			addi     r15, 4
			cpy_cc   r15, acc32
			sra      r12, 7                ; 1/128 keeps the sum in range
			macrd    acc32, ring+1618
			rddelx   r12, r15
			addi     r15, 4
			cpy_cc   r15, acc32
			sra      r12, 7                ; 1/128 keeps the sum in range
			macrd    acc32, ring+1622
			rddelx   r12, r15
			addi     r15, 4
			cpy_cc   r15, acc32
			sra      r12, 7                ; 1/128 keeps the sum in range
			macrd    acc32, ring+1626
			rddelx   r12, r15
			addi     r15, 4
			cpy_cc   r15, acc32
			sra      r12, 7                ; 1/128 keeps the sum in range
			macrd    acc32, ring+1630
			rddelx   r12, r15
			addi     r15, 4
			cpy_cc   r15, acc32
			sra      r12, 7                ; 1/128 keeps the sum in range
			macrd    acc32, ring+1634
			rddelx   r12, r15
			addi     r15, 4
			cpy_cc   r15, acc32
			sra      r12, 7                ; 1/128 keeps the sum in range
			macrd    acc32, ring+1638
			rddelx   r12, r15
			addi     r15, 4
			cpy_cc   r15, acc32
			sra      r12, 7                ; 1/128 keeps the sum in range
			macrd    acc32, ring+1642
			rddelx   r12, r15
			addi     r15, 4
			cpy_cc   r15, acc32
			sra      r12, 7                ; 1/128 keeps the sum in range
			macrd    acc32, ring+1646
			rddelx   r12, r15
			addi     r15, 4
			cpy_cc   r15, acc32
			sra      r12, 7                ; 1/128 keeps the sum in range
			macrd    acc32, ring+1650
			rddelx   r12, r15
			sra      r12, 7                ; 1/128 keeps the sum in range
			macrd    acc32, ring+1654
			rdacc64u r12                   ; c
			jneg     r12, next_lag         ; no splice on an anti-correlation
			jz       r12, next_lag
			log2     r12
			cpy_cc   r13, acc32
			log2     r8
			sra      acc32, 1
			sub      r13, acc32            ; score = log2 c - log2 e / 2
			cpy_cc   r13, acc32
			cpy_cm   r12, mbase+0
			sub      r13, r12                ; against the best so far
			cpy_cc   r14, acc32
			addi     r7, -201
			jneg     acc32, tie_near     ; a lag past the nominal must beat it outright
			addi     r14, -1
			cpy_cc   r14, acc32
			tie_near:
			jneg     r14, next_lag
			cpy_mc   mbase+0, r13
			addi     r7, -200
			cpy_mc   mbase+1, acc32
			next_lag:
			addi     r7, 1
			cpy_cc   r7, acc32
			addi     r7, -401
			jneg     acc32, no_search
			xor      acc32, acc32
			addi     acc32, -1
			cpy_cc   r7, acc32           ; all lags seen
			no_search:

			; ---- the request: when the tap will reach its edge in 404 ticks
			jnz      r6, no_req
			jgez     r5, no_req
			jz       r2, no_req
			cpy_cc   r12, r2
			jgez     r2, step_pos
			neg      r2
			cpy_cc   r12, acc32
			step_pos:
			sl       r12, 14
			cpy_cc   r12, acc32
			wrdld    r13, 12928         ; 404 * 32
			multrr   r12, r13
			sra      acc32, 4
			cpy_cc   r13, acc32            ; lead = |step| * 404, 16.16
			jneg     r2, rem_up
			wrdld    r12, 1460
			sub      r12, r3              ; down: the far edge is ahead
			jmp      rem_done
			rem_up:
			wrdld    r12, 436
			sub      r3, r12              ; up: the near edge
			rem_done:
			cpy_cc   r14, acc32            ; remaining
			jneg     r14, past_edge
			sub      r13, r14
			jneg     acc32, no_req
			xor      acc32, acc32
			addi     acc32, 404
			cpy_cc   r6, acc32
			cpy_mc   mbase+2, r2
			xor      acc32, acc32
			cpy_cc   r7, acc32           ; the search starts next tick
			cpy_mc   mbase+1, acc32
			wrdld    r12, 0x8000
			cpy_mc   mbase+0, r12            ; best score = -inf
			cpy_cm   r12, mbase+5
			addi     r12, 1
			cpy_mc   mbase+5, acc32
			jmp      no_req
			past_edge:
			; the tap is already past the edge it is walking to (the pitch changed
			; mid-grain): splice next tick at the nominal lag, unsearched
			xor      acc32, acc32
			addi     acc32, 1
			cpy_cc   r6, acc32
			cpy_mc   mbase+2, r2
			xor      acc32, acc32
			cpy_mc   mbase+1, acc32
			no_req:

			; ---- the taps
			interp   r3, ring
			cpy_cc   r12, acc32            ; a
			jneg     r5, one_tap
			interp   r4, ring
			sub      acc32, r12            ; b - a
			cpy_cc   r13, acc32
			sl       r5, 23               ; fc / 256, S.31
			multrr   r13, acc32
			adds     acc32, r12            ; a + (b - a) * fade
			cpy_cc   r12, acc32
			one_tap:

			; ---- advance the taps; the fade done, the new tap is the tap
			add      r3, r2
			cpy_cc   r3, acc32
			jneg     r5, advanced
			add      r4, r2
			cpy_cc   r4, acc32
			addi     r5, 1
			cpy_cc   r5, acc32
			addi     r5, -256
			jneg     acc32, advanced
			cpy_cc   r3, r4
			xor      acc32, acc32
			addi     acc32, -1
			cpy_cc   r5, acc32
			advanced:

			; ---- state, and the wet signal out
			cpy_mc   mbase+7, r3
			cpy_mc   mbase+8, r4
			cpy_mc   mbase+9, r5
			cpy_mc   mbase+10, r6
			cpy_mc   mbase+11, r7
			cpy_mc   mbase+12, r8
			cpy_mc   mbase+13, r9
			cpy_mc   mbase+14, r10
			cpy_mc   mbase+15, r11
			cpy_mc   out, r12
		</code>
	</sub>
</library>
