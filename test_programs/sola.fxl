<library>
	<name>sola</name>
	<desc>SOLA pitch shifter, one octave down to one octave up. Generated by gen-sola.js; edit that, not this.</desc>
	<lib_color>0, 128, 160</lib_color>
	<lib_text_color>255,255,255</lib_text_color>
	<sub>
		<name>shifter</name>
		<desc>Pitch shifts in by -1 to +1 octave and writes the wet signal to out; mix it with the dry signal outside. Uses 16 MREGs from mbase up (mbase+0..6 search and status, +7..15 state), 2048 samples of delay memory and all of r0..r15 as scratch.</desc>
		<param>
			<name>in</name>
			<side>L</side>
			<type>MREG</type>
			<desc>MREG holding the signal to shift</desc>
		</param>
		<param>
			<name>pitch</name>
			<side>L</side>
			<type>MREG</type>
			<desc>MREG holding the pitch, 0 = -1 octave, 0.5 = unity, 1 = +1 octave</desc>
		</param>
		<param>
			<name>out</name>
			<side>R</side>
			<type>MREG</type>
			<desc>MREG to receive the shifted (wet) signal</desc>
		</param>
		<param>
			<name>mbase</name>
			<type>MREG</type>
			<desc>First of the 16 MREGs the shifter keeps its state in, e.g. mr0</desc>
		</param>
		<code>
			.mem  ring  2048

			; ---- input
			cpy_cm   r0, in
			wrdel    ring, r0

			; ---- state
			cpy_cm   r3, mbase+7
			cpy_cm   r4, mbase+8
			cpy_cm   r5, mbase+9
			cpy_cm   r6, mbase+10
			cpy_cm   r7, mbase+11
			cpy_cm   r8, mbase+12
			cpy_cm   r9, mbase+13
			cpy_cm   r10, mbase+14
			cpy_cm   r11, mbase+15

			; ---- first sample: seat the tap mid-excursion, nothing fading or due
			cpy_cs   r12, samplecnt
			jnz      r12, inited
			wrdld    r3, 948
			xor      acc32, acc32
			addi     acc32, -1
			cpy_cc   r5, acc32
			cpy_cc   r7, acc32
			inited:

			; ---- pitch: ratio = 2^(2p - 1), by way of 2^(2p - 2) = ratio / 2
			cpy_cm   r12, pitch
			sra      r12, 4                ; 2p in S5.26
			addsi    acc32, -0.0625      ; - 2.0
			addi     acc32, -1           ; stays negative at p = 1
			exp2     acc32               ; ratio / 2, S.31
			sra      acc32, 14           ; ratio, Q16
			cpy_cc   r1, acc32
			wrdld    r2, 1
			sub      r2, r1
			cpy_cc   r2, acc32

			; ---- far window energy, a running sum that drifts with the delay line
			rddel    r12, ring+1258
			multrr   r12, r12
			sra      acc32, 7
			cpy_cc   r13, acc32
			rddel    r12, ring+1658
			multrr   r12, r12
			sra      acc32, 7
			sub      r13, acc32
			add      acc32, r11           ; the sum four ticks ago, plus the new point, less the old
			cpy_cc   r11, r10
			cpy_cc   r10, r9
			cpy_cc   r9, r8
			cpy_cc   r8, acc32

			; ---- the splice, when the countdown runs out
			jz       r6, no_splice
			addi     r6, -1
			cpy_cc   r6, acc32
			jnz      r6, no_splice
			cpy_cm   r14, mbase+1          ; the best lag
			jneg     r7, answered
			xor      acc32, acc32        ; the search is still running: take the nominal lag
			cpy_cc   r14, acc32
			addi     acc32, -1
			cpy_cc   r7, acc32
			cpy_cm   r12, mbase+4
			addi     r12, 1
			cpy_mc   mbase+4, acc32
			answered:
			cpy_mc   mbase+6, r14
			cpy_cm   r12, mbase+2
			jneg     r12, splice_up
			addi     r14, 436               ; down: the new tap starts at the near edge
			jmp      seated
			splice_up:
			neg      r14
			addi     acc32, 1460           ; up: at the far edge
			seated:
			sl       acc32, 16
			cpy_cc   r4, acc32
			xor      acc32, acc32
			cpy_cc   r5, acc32
			cpy_cm   r12, mbase+3
			addi     r12, 1
			cpy_mc   mbase+3, acc32
			no_splice:

			; ---- the search: lag sj - 200, the far window read where it has drifted to
			jneg     r7, no_search
			addi     r7, ring+34       ; the near window, 33 deep at the request, has drifted sj + 1
			cpy_cc   r15, acc32
			clracc64
			rddelx   r12, r15
			addi     r15, 4
			cpy_cc   r15, acc32
			sra      r12, 7                ; 1/128 keeps the sum in range
			macrd    acc32, ring+1258
			rddelx   r12, r15
			addi     r15, 4
			cpy_cc   r15, acc32
			sra      r12, 7                ; 1/128 keeps the sum in range
			macrd    acc32, ring+1262
			rddelx   r12, r15
			addi     r15, 4
			cpy_cc   r15, acc32
			sra      r12, 7                ; 1/128 keeps the sum in range
			macrd    acc32, ring+1266
			rddelx   r12, r15
			addi     r15, 4
			cpy_cc   r15, acc32
			sra      r12, 7                ; 1/128 keeps the sum in range
			macrd    acc32, ring+1270
			rddelx   r12, r15
			addi     r15, 4
			cpy_cc   r15, acc32
			sra      r12, 7                ; 1/128 keeps the sum in range
			macrd    acc32, ring+1274
			rddelx   r12, r15
			addi     r15, 4
			cpy_cc   r15, acc32
			sra      r12, 7                ; 1/128 keeps the sum in range
			macrd    acc32, ring+1278
			rddelx   r12, r15
			addi     r15, 4
			cpy_cc   r15, acc32
			sra      r12, 7                ; 1/128 keeps the sum in range
			macrd    acc32, ring+1282
			rddelx   r12, r15
			addi     r15, 4
			cpy_cc   r15, acc32
			sra      r12, 7                ; 1/128 keeps the sum in range
			macrd    acc32, ring+1286
			rddelx   r12, r15
			addi     r15, 4
			cpy_cc   r15, acc32
			sra      r12, 7                ; 1/128 keeps the sum in range
			macrd    acc32, ring+1290
			rddelx   r12, r15
			addi     r15, 4
			cpy_cc   r15, acc32
			sra      r12, 7                ; 1/128 keeps the sum in range
			macrd    acc32, ring+1294
			rddelx   r12, r15
			addi     r15, 4
			cpy_cc   r15, acc32
			sra      r12, 7                ; 1/128 keeps the sum in range
			macrd    acc32, ring+1298
			rddelx   r12, r15
			addi     r15, 4
			cpy_cc   r15, acc32
			sra      r12, 7                ; 1/128 keeps the sum in range
			macrd    acc32, ring+1302
			rddelx   r12, r15
			addi     r15, 4
			cpy_cc   r15, acc32
			sra      r12, 7                ; 1/128 keeps the sum in range
			macrd    acc32, ring+1306
			rddelx   r12, r15
			addi     r15, 4
			cpy_cc   r15, acc32
			sra      r12, 7                ; 1/128 keeps the sum in range
			macrd    acc32, ring+1310
			rddelx   r12, r15
			addi     r15, 4
			cpy_cc   r15, acc32
			sra      r12, 7                ; 1/128 keeps the sum in range
			macrd    acc32, ring+1314
			rddelx   r12, r15
			addi     r15, 4
			cpy_cc   r15, acc32
			sra      r12, 7                ; 1/128 keeps the sum in range
			macrd    acc32, ring+1318
			rddelx   r12, r15
			addi     r15, 4
			cpy_cc   r15, acc32
			sra      r12, 7                ; 1/128 keeps the sum in range
			macrd    acc32, ring+1322
			rddelx   r12, r15
			addi     r15, 4
			cpy_cc   r15, acc32
