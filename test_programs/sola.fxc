macrd    acc32, ring+1654
rdacc64u t                   ; c
jneg     t, next_lag         ; no splice on an anti-correlation
jz       t, next_lag
log2     t
cpy_cc   u, acc32
log2     e0
sra      acc32, 1
sub      u, acc32            ; score = log2 c - log2 e / 2
cpy_cc   u, acc32
cpy_cm   t, mr0
sub      u, t                ; against the best so far
cpy_cc   v, acc32
addi     sj, -201
jneg     acc32, tie_near     ; a lag past the nominal must beat it outright
addi     v, -1
cpy_cc   v, acc32
tie_near:
jneg     v, next_lag
cpy_mc   mr0, u
addi     sj, -200
cpy_mc   mr1, acc32
next_lag:
addi     sj, 1
cpy_cc   sj, acc32
addi     sj, -401
jneg     acc32, no_search
xor      acc32, acc32
addi     acc32, -1
cpy_cc   sj, acc32           ; all lags seen
no_search:

; ---- the request: when the tap will reach its edge in 404 ticks
jnz      cd, no_req
jgez     fc, no_req
jz       step, no_req
cpy_cc   t, step
jgez     step, step_pos
neg      step
cpy_cc   t, acc32
step_pos:
sl       t, 14
cpy_cc   t, acc32
wrdld    u, 12928         ; 404 * 32
multrr   t, u
sra      acc32, 4
cpy_cc   u, acc32            ; lead = |step| * 404, 16.16
jneg     step, rem_up
wrdld    t, 1460
sub      t, d_a              ; down: the far edge is ahead
jmp      rem_done
rem_up:
wrdld    t, 436
sub      d_a, t              ; up: the near edge
rem_done:
cpy_cc   v, acc32            ; remaining
jneg     v, past_edge
sub      u, v
jneg     acc32, no_req
xor      acc32, acc32
addi     acc32, 404
cpy_cc   cd, acc32
cpy_mc   mr2, step
xor      acc32, acc32
cpy_cc   sj, acc32           ; the search starts next tick
cpy_mc   mr1, acc32
wrdld    t, 0x8000
cpy_mc   mr0, t            ; best score = -inf
cpy_cm   t, mr5
addi     t, 1
cpy_mc   mr5, acc32
jmp      no_req
past_edge:
; the tap is already past the edge it is walking to (the pitch changed
; mid-grain): splice next tick at the nominal lag, unsearched
xor      acc32, acc32
addi     acc32, 1
cpy_cc   cd, acc32
cpy_mc   mr2, step
xor      acc32, acc32
cpy_mc   mr1, acc32
no_req:

; ---- the taps
interp   d_a, ring
cpy_cc   t, acc32            ; a
jneg     fc, one_tap
interp   d_b, ring
sub      acc32, t            ; b - a
cpy_cc   u, acc32
sl       fc, 23               ; fc / 256, S.31
multrr   u, acc32
adds     acc32, t            ; a + (b - a) * fade
cpy_cc   t, acc32
one_tap:

; ---- advance the taps; the fade done, the new tap is the tap
add      d_a, step
cpy_cc   d_a, acc32
jneg     fc, advanced
add      d_b, step
cpy_cc   d_b, acc32
addi     fc, 1
cpy_cc   fc, acc32
addi     fc, -256
jneg     acc32, advanced
cpy_cc   d_a, d_b
xor      acc32, acc32
addi     acc32, -1
cpy_cc   fc, acc32
advanced:

; ---- mix
cpy_cs   u, pot1_smth
subs     t, dry              ; wet - dry
multrr   acc32, u
adds     acc32, dry
cpy_sc   out0, acc32
cpy_sc   out1, acc32
