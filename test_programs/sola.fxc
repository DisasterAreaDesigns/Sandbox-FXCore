macrd    t, ring+1486
cpy_cm   t, mr58
macrd    t, ring+1490
cpy_cm   t, mr59
macrd    t, ring+1494
cpy_cm   t, mr60
macrd    t, ring+1498
cpy_cm   t, mr61
macrd    t, ring+1502
cpy_cm   t, mr62
macrd    t, ring+1506
cpy_cm   t, mr63
macrd    t, ring+1510
cpy_cm   t, mr64
macrd    t, ring+1514
cpy_cm   t, mr65
macrd    t, ring+1518
cpy_cm   t, mr66
macrd    t, ring+1522
cpy_cm   t, mr67
macrd    t, ring+1526
cpy_cm   t, mr68
macrd    t, ring+1530
cpy_cm   t, mr69
macrd    t, ring+1534
cpy_cm   t, mr70
macrd    t, ring+1538
cpy_cm   t, mr71
macrd    t, ring+1542
cpy_cm   t, mr72
macrd    t, ring+1546
cpy_cm   t, mr73
macrd    t, ring+1550
cpy_cm   t, mr74
macrd    t, ring+1554
cpy_cm   t, mr75
macrd    t, ring+1558
cpy_cm   t, mr76
macrd    t, ring+1562
cpy_cm   t, mr77
macrd    t, ring+1566
cpy_cm   t, mr78
macrd    t, ring+1570
cpy_cm   t, mr79
macrd    t, ring+1574
cpy_cm   t, mr80
macrd    t, ring+1578
cpy_cm   t, mr81
macrd    t, ring+1582
cpy_cm   t, mr82
macrd    t, ring+1586
cpy_cm   t, mr83
macrd    t, ring+1590
cpy_cm   t, mr84
macrd    t, ring+1594
cpy_cm   t, mr85
macrd    t, ring+1598
cpy_cm   t, mr86
macrd    t, ring+1602
cpy_cm   t, mr87
macrd    t, ring+1606
cpy_cm   t, mr88
macrd    t, ring+1610
cpy_cm   t, mr89
macrd    t, ring+1614
cpy_cm   t, mr90
macrd    t, ring+1618
cpy_cm   t, mr91
macrd    t, ring+1622
cpy_cm   t, mr92
macrd    t, ring+1626
cpy_cm   t, mr93
macrd    t, ring+1630
cpy_cm   t, mr94
macrd    t, ring+1634
cpy_cm   t, mr95
macrd    t, ring+1638
cpy_cm   t, mr96
macrd    t, ring+1642
cpy_cm   t, mr97
macrd    t, ring+1646
cpy_cm   t, mr98
macrd    t, ring+1650
cpy_cm   t, mr99
macrd    t, ring+1654
rdacc64u t                   ; c
jneg     t, next_lag         ; no splice on an anti-correlation
jz       t, next_lag
log2     t
cpy_cc   u, acc32
log2     e0
sra      acc32, 1
sub      u, acc32            ; score = log2 c - log2 e / 2
cpy_cc   u, acc32
cpy_cm   t, mr100
sub      u, t                ; against the best so far
cpy_cc   v, acc32
addi     sj, -201
jneg     acc32, tie_near     ; a lag past the nominal must beat it outright
addi     v, -1
cpy_cc   v, acc32
tie_near:
jneg     v, next_lag
cpy_mc   mr100, u
addi     sj, -200
cpy_mc   mr101, acc32
next_lag:
addi     sj, 1
cpy_cc   sj, acc32
addi     sj, -401
jneg     acc32, no_search
xor      acc32, acc32
addi     acc32, -1
cpy_cc   sj, acc32           ; all lags seen
no_search:

; ---- the request: when the tap will reach its edge in 404 ticks
jnz      cd, no_req
jgez     fc, no_req
jz       step, no_req
cpy_cc   t, step
jgez     step, step_pos
neg      step
cpy_cc   t, acc32
step_pos:
sl       t, 14
cpy_cc   t, acc32
wrdld    u, 404<<5
multrr   t, u
sra      acc32, 4
cpy_cc   u, acc32            ; lead = |step| * 404, 16.16
jneg     step, rem_up
wrdld    t, 1460
sub      t, d_a              ; down: the far edge is ahead
jmp      rem_done
rem_up:
wrdld    t, 436
sub      d_a, t              ; up: the near edge
rem_done:
cpy_cc   v, acc32            ; remaining
jneg     v, past_edge
sub      u, v
jneg     acc32, no_req
xor      acc32, acc32
addi     acc32, 404
cpy_cc   cd, acc32
cpy_mc   mr102, step
xor      acc32, acc32
cpy_cc   sj, acc32           ; the search starts next tick
cpy_mc   mr101, acc32
wrdld    t, 0x8000
cpy_mc   mr100, t            ; best score = -inf
cpy_cm   t, mr105
addi     t, 1
cpy_mc   mr105, acc32
; the near window, every fourth sample, scaled by 1/128 to keep the sums in range
rddel    t, ring+33
sra      t, 7
cpy_mc   mr0, acc32
rddel    t, ring+37
sra      t, 7
cpy_mc   mr1, acc32
rddel    t, ring+41
sra      t, 7
cpy_mc   mr2, acc32
rddel    t, ring+45
sra      t, 7
cpy_mc   mr3, acc32
rddel    t, ring+49
sra      t, 7
cpy_mc   mr4, acc32
rddel    t, ring+53
sra      t, 7
cpy_mc   mr5, acc32
rddel    t, ring+57
sra      t, 7
cpy_mc   mr6, acc32
rddel    t, ring+61
sra      t, 7
cpy_mc   mr7, acc32
rddel    t, ring+65
sra      t, 7
cpy_mc   mr8, acc32
rddel    t, ring+69
sra      t, 7
cpy_mc   mr9, acc32
rddel    t, ring+73
sra      t, 7
cpy_mc   mr10, acc32
rddel    t, ring+77
