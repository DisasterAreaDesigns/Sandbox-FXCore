cpy_mc   mr29, acc32
rddel    t, ring+153
sra      t, 7
cpy_mc   mr30, acc32
rddel    t, ring+157
sra      t, 7
cpy_mc   mr31, acc32
rddel    t, ring+161
sra      t, 7
cpy_mc   mr32, acc32
rddel    t, ring+165
sra      t, 7
cpy_mc   mr33, acc32
rddel    t, ring+169
