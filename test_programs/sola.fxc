cpy_mc   mr36, acc32
rddel    t, ring+181
sra      t, 7
cpy_mc   mr37, acc32
rddel    t, ring+185
sra      t, 7
cpy_mc   mr38, acc32
rddel    t, ring+189
sra      t, 7
cpy_mc   mr39, acc32
rddel    t, ring+193
