; sola.fxc - SOLA pitch shifter, one octave down to one octave up.
; Generated by gen-sola.js; edit that, not this.
;
; #POT0 Pitch
; #POT1 Mix
; #SW0 Free pitch
; #USER0 Snap
;
; POT0_SMTH  pitch, -1 octave at 0, unity at the centre, +1 octave at 1
; POT1_SMTH  mix, dry to wet
; SW0        off: the pitch snaps to semitones, from a table at
;            MR7..MR31; on: the pot sets it freely.  USER0 lit when snapping
;
; A tap walks a 1024-sample stretch of the delay line at (1 - ratio) samples
; per sample, so what it reads is the input resampled.  404 ticks before
; it reaches an end the search starts: one lag per tick, the near window
; (every fourth of 400 samples, 33 deep at the request) is correlated
; against the far window as the delay line drifts past, lags -200..+200.
; Both are read where they sit in the delay line; the near window is
; followed with a pointer as it drifts, so nothing is copied out.
; At the splice a second tap starts at the other end, offset by the best
; lag, and fades in over 256 samples.  Correlation and window energy are
; scored as log2 c - log2 e / 2, ties going to the nominal lag.
;
; MR0  best score   MR1  best lag   MR2  step at the request
; MR3  splices     MR4  missed     MR5  searches   MR6  last lag
; MR7..MR31  pitch ratio for -12..+12 semitones, Q16

.rn   dry   r0
.rn   ratio r1        ; Q16
.rn   step  r2        ; Q16, 1 - ratio: the tap's change of delay per tick
.rn   d_a   r3        ; live tap's delay, 16.16
.rn   d_b   r4        ; fading-in tap's delay, 16.16
.rn   fc    r5        ; fade count, -1 when not fading
.rn   cd    r6        ; ticks to the splice, 0 when none is due
.rn   sj    r7        ; search index 0..400, -1 when idle
.rn   e0    r8        ; far window energy, this tick
.rn   e1    r9        ;   and the three before it
.rn   e2    r10
.rn   e3    r11
.rn   t     r12
.rn   u     r13
.rn   v     r14
.rn   w     r15

.mem  ring  2048

; the semitone table: 2^(k/12) in Q16, 65536 = unity
.mreg mr7   32768   ; -12
.mreg mr8   34716   ; -11
.mreg mr9   36781   ; -10
.mreg mr10  38968   ; -9
.mreg mr11  41285   ; -8
.mreg mr12  43740   ; -7
.mreg mr13  46341   ; -6
.mreg mr14  49097   ; -5
.mreg mr15  52016   ; -4
.mreg mr16  55109   ; -3
.mreg mr17  58386   ; -2
.mreg mr18  61858   ; -1
.mreg mr19  65536   ; 0
.mreg mr20  69433   ; +1
.mreg mr21  73562   ; +2
.mreg mr22  77936   ; +3
.mreg mr23  82570   ; +4
.mreg mr24  87480   ; +5
.mreg mr25  92682   ; +6
.mreg mr26  98193   ; +7
.mreg mr27  104032  ; +8
.mreg mr28  110218  ; +9
.mreg mr29  116772  ; +10
.mreg mr30  123715  ; +11
.mreg mr31  131072  ; +12

; ---- input
cpy_cs   dry, in0
wrdel    ring, dry

; ---- first sample: seat the tap mid-excursion, nothing fading or due
cpy_cs   t, samplecnt
jnz      t, inited
wrdld    d_a, 948
xor      acc32, acc32
addi     acc32, -1
cpy_cc   fc, acc32
cpy_cc   sj, acc32
inited:

; ---- pitch, snapped: the pot cut into 25 equal slices, one per semitone
cpy_cs   t, pot0_smth
cpy_cs   u, switch
andi     u, sw0db            ; 1 while SW0 is off
set      user0|0, acc32
jz       acc32, free_pitch
multri   t, 25/32            ; 25p / 32, so each slice is 1/32 = 2^26
sr       acc32, 26           ; floor(25p) = k + 12, 0..24
addi     acc32, 7
cpy_cmx  ratio, acc32
jmp      have_ratio

; ---- pitch, free: ratio = 2^(2p - 1), by way of 2^(2p - 2) = ratio / 2
free_pitch:
sra      t, 4                ; 2p in S5.26
addsi    acc32, -0.0625      ; - 2.0
addi     acc32, -1           ; stays negative at p = 1
exp2     acc32               ; ratio / 2, S.31
sra      acc32, 14           ; ratio, Q16
cpy_cc   ratio, acc32
have_ratio:
wrdld    step, 1
sub      step, ratio
cpy_cc   step, acc32

; ---- far window energy, a running sum that drifts with the delay line
rddel    t, ring+1258
multrr   t, t
sra      acc32, 7
cpy_cc   u, acc32
rddel    t, ring+1658
multrr   t, t
sra      acc32, 7
sub      u, acc32
add      acc32, e3           ; the sum four ticks ago, plus the new point, less the old
cpy_cc   e3, e2
cpy_cc   e2, e1
cpy_cc   e1, e0
cpy_cc   e0, acc32

; ---- the splice, when the countdown runs out
jz       cd, no_splice
addi     cd, -1
cpy_cc   cd, acc32
jnz      cd, no_splice
cpy_cm   v, mr1          ; the best lag
jneg     sj, answered
xor      acc32, acc32        ; the search is still running: take the nominal lag
cpy_cc   v, acc32
addi     acc32, -1
cpy_cc   sj, acc32
cpy_cm   t, mr4
addi     t, 1
cpy_mc   mr4, acc32
answered:
cpy_mc   mr6, v
cpy_cm   t, mr2
jneg     t, splice_up
addi     v, 436               ; down: the new tap starts at the near edge
jmp      seated
splice_up:
neg      v
addi     acc32, 1460           ; up: at the far edge
seated:
sl       acc32, 16
cpy_cc   d_b, acc32
xor      acc32, acc32
cpy_cc   fc, acc32
cpy_cm   t, mr3
addi     t, 1
cpy_mc   mr3, acc32
no_splice:

; ---- the search: lag sj - 200, the far window read where it has drifted to
jneg     sj, no_search
addi     sj, ring+34       ; the near window, 33 deep at the request, has drifted sj + 1
cpy_cc   w, acc32
clracc64
rddelx   t, w
addi     w, 4
cpy_cc   w, acc32
sra      t, 7                ; 1/128 keeps the sum in range
macrd    acc32, ring+1258
rddelx   t, w
addi     w, 4
cpy_cc   w, acc32
sra      t, 7                ; 1/128 keeps the sum in range
macrd    acc32, ring+1262
rddelx   t, w
addi     w, 4
cpy_cc   w, acc32
sra      t, 7                ; 1/128 keeps the sum in range
macrd    acc32, ring+1266
rddelx   t, w
addi     w, 4
cpy_cc   w, acc32
sra      t, 7                ; 1/128 keeps the sum in range
macrd    acc32, ring+1270
