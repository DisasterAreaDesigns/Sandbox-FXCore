; sola.fxc - SOLA pitch shifter, one octave down to one octave up.
; Generated by gen-sola.js; edit that, not this.
;
; POT0_SMTH  pitch, -1 octave at 0, unity at the centre, +1 octave at 1
; POT1_SMTH  mix, dry to wet
;
; A tap walks a 1024-sample stretch of the delay line at (1 - ratio) samples
; per sample, so what it reads is the input resampled.  404 ticks before
; it reaches an end the near window (every fourth of 400 samples at delay
; 436) is copied into MR0..MR99, and one lag per tick it is correlated
; against the far window as the delay line drifts past, lags -200..+200.
; At the splice a second tap starts at the other end, offset by the best
; lag, and fades in over 256 samples.  Correlation and window energy are
; scored as log2 c - log2 e / 2, ties going to the nominal lag.
;
; MR100  best score   MR101  best lag   MR102  step at the request
; MR103  splices     MR104  missed     MR105  searches   MR106  last lag

.rn   dry   r0
.rn   ratio r1        ; Q16
.rn   step  r2        ; Q16, 1 - ratio: the tap's change of delay per tick
.rn   d_a   r3        ; live tap's delay, 16.16
.rn   d_b   r4        ; fading-in tap's delay, 16.16
.rn   fc    r5        ; fade count, -1 when not fading
.rn   cd    r6        ; ticks to the splice, 0 when none is due
.rn   sj    r7        ; search index 0..400, -1 when idle
.rn   e0    r8        ; far window energy, this tick
.rn   e1    r9        ;   and the three before it
.rn   e2    r10
.rn   e3    r11
.rn   t     r12
.rn   u     r13
.rn   v     r14
.rn   w     r15

.mem  ring  2048

; ---- input
cpy_cs   dry, in0
wrdel    ring, dry

; ---- first sample: seat the tap mid-excursion, nothing fading or due
cpy_cs   t, samplecnt
jnz      t, inited
wrdld    d_a, 948
xor      acc32, acc32
addi     acc32, -1
cpy_cc   fc, acc32
cpy_cc   sj, acc32
inited:

; ---- pitch: ratio = 2^(2p - 1), by way of 2^(2p - 2) = ratio / 2
cpy_cs   t, pot0_smth
sra      t, 4                ; 2p in S5.26
addsi    acc32, -0.0625      ; - 2.0
addi     acc32, -1           ; stays negative at p = 1
exp2     acc32               ; ratio / 2, S.31
sra      acc32, 14           ; ratio, Q16
cpy_cc   ratio, acc32
wrdld    step, 1
sub      step, ratio
cpy_cc   step, acc32

; ---- far window energy, a running sum that drifts with the delay line
rddel    t, ring+1258
multrr   t, t
sra      acc32, 7
cpy_cc   u, acc32
rddel    t, ring+1658
multrr   t, t
sra      acc32, 7
sub      u, acc32
add      acc32, e3           ; the sum four ticks ago, plus the new point, less the old
cpy_cc   e3, e2
cpy_cc   e2, e1
cpy_cc   e1, e0
cpy_cc   e0, acc32

; ---- the splice, when the countdown runs out
jz       cd, no_splice
addi     cd, -1
cpy_cc   cd, acc32
jnz      cd, no_splice
cpy_cm   v, mr101          ; the best lag
jneg     sj, answered
xor      acc32, acc32        ; the search is still running: take the nominal lag
cpy_cc   v, acc32
addi     acc32, -1
cpy_cc   sj, acc32
cpy_cm   t, mr104
addi     t, 1
cpy_mc   mr104, acc32
answered:
cpy_mc   mr106, v
cpy_cm   t, mr102
jneg     t, splice_up
addi     v, 436               ; down: the new tap starts at the near edge
jmp      seated
splice_up:
neg      v
addi     acc32, 1460           ; up: at the far edge
seated:
sl       acc32, 16
cpy_cc   d_b, acc32
xor      acc32, acc32
cpy_cc   fc, acc32
cpy_cm   t, mr103
addi     t, 1
cpy_mc   mr103, acc32
no_splice:

; ---- the search: lag sj - 200, the far window read where it has drifted to
jneg     sj, no_search
clracc64
cpy_cm   t, mr0
macrd    t, ring+1258
cpy_cm   t, mr1
macrd    t, ring+1262
cpy_cm   t, mr2
macrd    t, ring+1266
cpy_cm   t, mr3
macrd    t, ring+1270
cpy_cm   t, mr4
macrd    t, ring+1274
cpy_cm   t, mr5
macrd    t, ring+1278
cpy_cm   t, mr6
macrd    t, ring+1282
cpy_cm   t, mr7
macrd    t, ring+1286
cpy_cm   t, mr8
macrd    t, ring+1290
cpy_cm   t, mr9
macrd    t, ring+1294
cpy_cm   t, mr10
macrd    t, ring+1298
cpy_cm   t, mr11
macrd    t, ring+1302
cpy_cm   t, mr12
macrd    t, ring+1306
cpy_cm   t, mr13
macrd    t, ring+1310
cpy_cm   t, mr14
macrd    t, ring+1314
cpy_cm   t, mr15
macrd    t, ring+1318
cpy_cm   t, mr16
macrd    t, ring+1322
cpy_cm   t, mr17
macrd    t, ring+1326
cpy_cm   t, mr18
macrd    t, ring+1330
cpy_cm   t, mr19
macrd    t, ring+1334
cpy_cm   t, mr20
macrd    t, ring+1338
cpy_cm   t, mr21
macrd    t, ring+1342
cpy_cm   t, mr22
macrd    t, ring+1346
cpy_cm   t, mr23
