cpy_mc   mr74, acc32
rddel    t, ring+333
sra      t, 7
cpy_mc   mr75, acc32
rddel    t, ring+337
sra      t, 7
cpy_mc   mr76, acc32
rddel    t, ring+341
sra      t, 7
cpy_mc   mr77, acc32
rddel    t, ring+345
sra      t, 7
cpy_mc   mr78, acc32
rddel    t, ring+349
sra      t, 7
cpy_mc   mr79, acc32
rddel    t, ring+353
sra      t, 7
cpy_mc   mr80, acc32
rddel    t, ring+357
