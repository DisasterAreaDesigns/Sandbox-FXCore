cpy_mc   mr13, acc32
rddel    t, ring+89
sra      t, 7
cpy_mc   mr14, acc32
rddel    t, ring+93
sra      t, 7
cpy_mc   mr15, acc32
rddel    t, ring+97
sra      t, 7
cpy_mc   mr16, acc32
rddel    t, ring+101
sra      t, 7
cpy_mc   mr17, acc32
rddel    t, ring+105
