cpy_mc   mr85, acc32
rddel    t, ring+377
sra      t, 7
cpy_mc   mr86, acc32
rddel    t, ring+381
sra      t, 7
cpy_mc   mr87, acc32
rddel    t, ring+385
sra      t, 7
cpy_mc   mr88, acc32
rddel    t, ring+389
sra      t, 7
cpy_mc   mr89, acc32
rddel    t, ring+393
sra      t, 7
cpy_mc   mr90, acc32
rddel    t, ring+397
sra      t, 7
cpy_mc   mr91, acc32
rddel    t, ring+401
sra      t, 7
cpy_mc   mr92, acc32
rddel    t, ring+405
sra      t, 7
cpy_mc   mr93, acc32
rddel    t, ring+409
sra      t, 7
cpy_mc   mr94, acc32
rddel    t, ring+413
sra      t, 7
cpy_mc   mr95, acc32
rddel    t, ring+417
sra      t, 7
cpy_mc   mr96, acc32
rddel    t, ring+421
sra      t, 7
cpy_mc   mr97, acc32
rddel    t, ring+425
sra      t, 7
cpy_mc   mr98, acc32
rddel    t, ring+429
sra      t, 7
cpy_mc   mr99, acc32
jmp      no_req
past_edge:
; the tap is already past the edge it is walking to (the pitch changed
; mid-grain): splice next tick at the nominal lag, unsearched
xor      acc32, acc32
addi     acc32, 1
cpy_cc   cd, acc32
cpy_mc   mr102, step
xor      acc32, acc32
cpy_mc   mr101, acc32
no_req:

; ---- the taps
interp   d_a, ring
cpy_cc   t, acc32            ; a
jneg     fc, one_tap
interp   d_b, ring
sub      acc32, t            ; b - a
cpy_cc   u, acc32
sl       fc, 23               ; fc / 256, S.31
multrr   u, acc32
adds     acc32, t            ; a + (b - a) * fade
cpy_cc   t, acc32
one_tap:

; ---- advance the taps; the fade done, the new tap is the tap
add      d_a, step
cpy_cc   d_a, acc32
jneg     fc, advanced
add      d_b, step
cpy_cc   d_b, acc32
addi     fc, 1
cpy_cc   fc, acc32
addi     fc, -256
jneg     acc32, advanced
cpy_cc   d_a, d_b
xor      acc32, acc32
addi     acc32, -1
cpy_cc   fc, acc32
advanced:

; ---- mix
cpy_cs   u, pot1_smth
subs     t, dry              ; wet - dry
multrr   acc32, u
adds     acc32, dry
cpy_sc   out0, acc32
cpy_sc   out1, acc32
